# ========================================================================
# IIT Delhi Virtual Labs - Smart Feedback Portal Configuration
# ========================================================================

# Flask Secret Key for Sessions
SECRET_KEY=iitd-vlabs-smart-feedback-key-2026-prod-sec

# Database Engine: 'auto', 'mysql', or 'sqlite'
# 'auto': Tries to connect to MySQL using credentials below; if unavailable, uses SQLite.
DB_TYPE=auto

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=iitd_feedback

# SQLite Database File Path (used when DB_TYPE=sqlite or during fallback)
SQLITE_DB_PATH=database/feedback.db

# Upload Folder and Max Payload Size
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=26214400

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@iitd2026

